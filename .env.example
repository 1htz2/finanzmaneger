# Copy to .env and adjust. Never commit .env.

# production | development (development enables /api/docs and the OpenAPI schema)
FM_ENV=production

# Where the SQLite database and backups live. Docker uses /data (mounted from ./data).
# FM_DATA_DIR=./backend/data

# Optional full SQLAlchemy URL instead of FM_DATA_DIR (SQLite only is supported).
# FM_DATABASE_URL=sqlite:////absolute/path/finanzmanager.db

# Secure cookie flag: auto = only when the request arrives via HTTPS
# (directly or through a proxy that sets X-Forwarded-Proto), true, false.
FM_COOKIE_SECURE=auto

# Session lifetime in days.
FM_SESSION_DAYS=30

# Login lockout after N failed attempts for M seconds.
FM_LOGIN_MAX_ATTEMPTS=5
FM_LOGIN_LOCKOUT_SECONDS=300

# Only needed if the frontend is served from a different origin than the API
# (not the case in the default setup). Comma separated.
# FM_CORS_ORIGINS=http://localhost:5173

# Docker Compose: network interface and port to publish.
# 127.0.0.1 = this computer only; 0.0.0.0 = also phones in your LAN.
FM_BIND=127.0.0.1
FM_PORT=8000

# Docker: proxies allowed to set X-Forwarded-* headers (e.g. tailscale serve on the host).
# FM_FORWARDED_ALLOW_IPS=127.0.0.1
